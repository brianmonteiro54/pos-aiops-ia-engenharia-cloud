{
  "mcpServers": {
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "mcp-server-kubernetes"],
      "env": {
        "ALLOW_ONLY_NON_DESTRUCTIVE_TOOLS": "true"
      },
      "disabled": false,
      "autoApprove": [
        "kubectl_get",
        "kubectl_describe",
        "kubectl_logs",
        "explain_resource",
        "list_api_resources",
        "ping"
      ]
    }
  }
}
