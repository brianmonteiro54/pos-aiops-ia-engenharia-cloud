# Host do laboratório com DESVIOS DELIBERADOS do baseline do parque.
#
# Serve ao critério de pronto "um host com desvios sai com cada desvio classificado pela
# severidade do baseline". Cada desvio abaixo está anotado com a regra e a severidade que
# o baseline atribui, para a validação poder conferir a classificação uma a uma.
FROM roster-lab-base:1

# DESVIO: servicos.ativos (alto): chrony NAO fica ativo.
RUN systemctl disable chrony

# DESVIO: servicos.proibidos (alto): rpcbind.socket ativo.
# O baseline distingue `.service` de `.socket`, e proibe justamente os dois sockets.
RUN apt-get update && apt-get install -y --no-install-recommends rpcbind \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && systemctl enable rpcbind.socket

# DESVIO: portas_em_escuta.somente_rede_interna (critico): node_exporter em 0.0.0.0.
# A diferenca com o host conforme e UMA flag. "9100 em 0.0.0.0" e "9100 so no endereco
# interno" tem vereditos diferentes, e e isso que esta sendo exercitado.
RUN printf '%s\n' \
    '[Unit]' \
    'Description=Prometheus Node Exporter' \
    'After=network.target' \
    '' \
    '[Service]' \
    'User=node_exporter' \
    'Group=node_exporter' \
    'Type=simple' \
    'ExecStart=/usr/local/bin/node_exporter --web.listen-address=0.0.0.0:9100' \
    '' \
    '[Install]' \
    'WantedBy=multi-user.target' \
    > /etc/systemd/system/node_exporter.service \
    && systemctl enable node_exporter

# DESVIO: ssh.login_de_root (alto): login de root permitido.
# E a configuracao EFETIVA que importa. Aqui o arquivo diz `yes` e `sshd -T` confirma.
RUN printf '%s\n' \
    'PermitRootLogin yes' \
    'PasswordAuthentication no' \
    'PubkeyAuthentication yes' \
    > /etc/ssh/sshd_config.d/00-metacortex.conf

# Usuario da coleta, tambem sem privilegio.
RUN useradd -m -s /bin/bash auditor \
    && mkdir -p /home/auditor/.ssh \
    && chmod 700 /home/auditor/.ssh
# DESVIO: chaves_ssh.emitidas_por (critico): uma chave da plataforma e uma de origem
# desconhecida, que e o caso real do Roster: "chaves SSH que ficaram para tras".
COPY chaves/auditor.pub /tmp/k1.pub
COPY chaves/intruso.pub /tmp/k2.pub
RUN cat /tmp/k1.pub /tmp/k2.pub > /home/auditor/.ssh/authorized_keys \
    && rm -f /tmp/k1.pub /tmp/k2.pub \
    && chmod 600 /home/auditor/.ssh/authorized_keys \
    && chown -R auditor:auditor /home/auditor/.ssh
